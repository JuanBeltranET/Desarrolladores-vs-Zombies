_spriteBatch.End();
base.Draw(gameTime);
return;
}

// Si estamos en el menu
if (estadoActual == EstadoJuego.Menu)
{
DibujarMenu();

base.Draw(gameTime);

return;
}

if (estadoActual == EstadoJuego.Opciones)
{
DibujarOpciones();

base.Draw(gameTime);

return;
}

if (estadoActual == EstadoJuego.MenuNuevo)
{
DibujarMenuNuevo();

base.Draw(gameTime);

return;
}

if (estadoActual == EstadoJuego.Pausa)
{
DibujarPausa();

base.Draw(gameTime);

return;
}

DibujarEscenaJuego();

base.Draw(gameTime);
}
